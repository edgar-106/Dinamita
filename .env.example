# Configuración de entorno INFONATEC Inmobiliaria
# Copia este archivo como .env y define tus valores locales o de producción.

APP_ENV=development

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_NAME=sistema_inmobiliario
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Correo autorizado para rol ADMIN
ADMIN_EMAIL=123@gmail.com

# Inteligencia Artificial ('gemini' o 'local')
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
