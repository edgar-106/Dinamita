# Configuración de entorno INFONATEC Inmobiliaria
# Copia este archivo como .env y define tus valores locales o de producción.

APP_ENV=development

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_NAME=sistema_inmobiliario
# En XAMPP local normalmente DB_USER=root y DB_PASS vacío
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Correo autorizado para rol ADMIN (debe coincidir con la cuenta administradora en BD)
ADMIN_EMAIL=123@gmail.com

# Inteligencia Artificial ('gemini' o 'local')
AI_PROVIDER=gemini
# Opcional: si queda vacío, el asistente usa automáticamente el motor local integrado
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Procesamiento de video para recorridos por escenas (opcional)
# En Windows/XAMPP normalmente C:\ffmpeg\bin\ffmpeg.exe y C:\ffmpeg\bin\ffprobe.exe
FFMPEG_PATH=
FFPROBE_PATH=
# Límite de subida en MB (no debe exceder upload_max_filesize ni post_max_size de php.ini)
VIDEO_MAX_MB=35
